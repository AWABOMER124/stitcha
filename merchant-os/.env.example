# Database
DATABASE_URL="postgresql://user:password@localhost:5432/waslak_merchant_os"

# Auth
AUTH_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# Required behind the known, controlled reverse proxy used in production.
AUTH_TRUST_HOST="true"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Deployment identifier shown by /api/health (prefer the deployed Git SHA)
APP_RELEASE="local"

# Storage (optional — falls back to local disk storage if unset)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_CDN_URL=
# Optional for S3-compatible providers such as MinIO or DigitalOcean Spaces.
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# Private receipts/proofs. Use a separate private bucket in production. The
# public S3 credentials/endpoint are reused when private-specific values are omitted.
# PRIVATE_S3_BUCKET=
# PRIVATE_S3_REGION=
# PRIVATE_S3_ACCESS_KEY=
# PRIVATE_S3_SECRET_KEY=
# PRIVATE_S3_ENDPOINT=
# PRIVATE_S3_FORCE_PATH_STYLE=false

# AI storefront content generator and WhatsApp customer-service agent (optional)
# ANTHROPIC_API_KEY=
# WHATSAPP_AI_MODEL=claude-haiku-4-5-20251001

# AI product image studio (optional and fail-closed). Requires an OpenAI project
# with GPT Image access. Keep the key server-side and enable only after setting
# a spend limit and durable S3 storage.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
AI_IMAGE_ENHANCEMENT_ENABLED=false

# Stripe hosted Checkout adapter. Fail-closed: no endpoint should expose Stripe
# until both secrets are configured and this flag is explicitly enabled.
STRIPE_PAYMENTS_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Required to store/read any encrypted tenant secret at rest — WhatsApp
# Business access tokens (WhatsAppConfig), delivery provider API credentials
# (DeliveryProviderConfig). Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY="generate-a-long-random-value-min-16-chars"

# WhatsApp Business Cloud API (optional — merchant WhatsApp inbox/ordering
# bot is unavailable if unset)
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Notification providers (optional by channel; delivery fails closed if unset)
# RESEND_API_KEY=
# EMAIL_FROM="WASLA <notifications@example.com>"
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_API_VERSION=vXX.X
# Meta-approved Authentication template used for signup OTP messages.
# WHATSAPP_OTP_TEMPLATE_NAME=wasla_account_verification
# WHATSAPP_OTP_TEMPLATE_LANGUAGE=ar
# Enable only after the business number and approved template pass a real test.
WHATSAPP_SIGNUP_VERIFICATION_ENABLED=false
# Optional dedicated HMAC secret; AUTH_SECRET is used when omitted.
# PHONE_OTP_SECRET=

# Seed safety guard — must be "true" to run `prisma db seed` when NODE_ENV=production
# ALLOW_SEED=

# Durable jobs: required by POST /api/internal/jobs/run. Configure the hosting
# scheduler to call the endpoint with Authorization: Bearer <secret>.
# Generate with: openssl rand -base64 32
# JOB_RUNNER_SECRET=
# Release flags: delivery stays off until partners, coordinates, and operations are verified.
PLATFORM_DELIVERY_ENABLED=false
# Legacy distributor portal is off by default; temporarily enable only for audited migration support.
DISTRIBUTOR_PORTAL_ENABLED=false
