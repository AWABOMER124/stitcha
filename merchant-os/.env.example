# Database
DATABASE_URL="postgresql://user:password@localhost:5432/waslak_merchant_os"

# Auth
AUTH_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# Required behind the known, controlled reverse proxy used in production.
AUTH_TRUST_HOST="true"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage (optional — falls back to local disk storage if unset)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_CDN_URL=

# AI storefront content generator (optional)
# ANTHROPIC_API_KEY=

# AI product image studio (optional and fail-closed). Requires an OpenAI project
# with GPT Image access. Keep the key server-side and enable only after setting
# a spend limit and durable S3 storage.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
AI_IMAGE_ENHANCEMENT_ENABLED=false

# Required to store/read any encrypted tenant secret at rest — WhatsApp
# Business access tokens (WhatsAppConfig), delivery provider API credentials
# (DeliveryProviderConfig). Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY="generate-a-long-random-value-min-16-chars"

# WhatsApp Business Cloud API (optional — merchant WhatsApp inbox/ordering
# bot is unavailable if unset)
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Notification providers (optional by channel; delivery fails closed if unset)
# RESEND_API_KEY=
# EMAIL_FROM="WASLA <notifications@example.com>"
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_API_VERSION=vXX.X

# Seed safety guard — must be "true" to run `prisma db seed` when NODE_ENV=production
# ALLOW_SEED=

# Durable jobs: required by POST /api/internal/jobs/run. Configure the hosting
# scheduler to call the endpoint with Authorization: Bearer <secret>.
# Generate with: openssl rand -base64 32
# JOB_RUNNER_SECRET=
# Release flags: delivery stays off until partners, coordinates, and operations are verified.
PLATFORM_DELIVERY_ENABLED=false
# Legacy distributor portal is off by default; temporarily enable only for audited migration support.
DISTRIBUTOR_PORTAL_ENABLED=false
