# Database
DATABASE_URL="postgresql://user:password@localhost:5432/waslak_merchant_os"

# Auth
AUTH_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage (optional — falls back to local disk storage if unset)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_CDN_URL=

# AI storefront generator (optional — /api/ai/generate-store returns 503 if unset)
# ANTHROPIC_API_KEY=

# Required to store/read any encrypted tenant secret at rest — WhatsApp
# Business access tokens (WhatsAppConfig), delivery provider API credentials
# (DeliveryProviderConfig). Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY="generate-a-long-random-value-min-16-chars"

# WhatsApp Business Cloud API (optional — merchant WhatsApp inbox/ordering
# bot is unavailable if unset)
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Notification providers (optional — console/NotificationLog mock if unset)
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# TWILIO_ACCOUNT_SID=
# AFRICASTALKING_API_KEY=

# Seed safety guard — must be "true" to run `prisma db seed` when NODE_ENV=production
# ALLOW_SEED=
