  FIXED_AMOUNT
  FREE_DELIVERY
}

// ============================================================================
// AUTH MODELS (NextAuth.js v5 compatible)
// ============================================================================

/// Platform user — can be linked to distributors and/or merchants
model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String?
  name                  String?
  phone                 String?   @unique
  role                  UserRole  @default(CASHIER)
  emailVerified         DateTime?
  phoneVerifiedAt       DateTime?
  authVersion           Int       @default(0)
  image                 String?
  platformAccessEnabled Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  merchantUsers        MerchantUser[]
  distributorUsers     DistributorUser[]
  deliveryPartnerUsers DeliveryPartnerUser[]
  accounts             Account[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  phoneVerifications   PhoneVerification[]
  partnerChallenges    PartnerVerificationChallenge[]

  @@map("users")
}

model PartnerVerificationChallenge {
  id        String    @id @default(cuid())
  userId    String
  channel   String
  target    String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("partner_verification_challenges")
}

// Intentionally separate from merchants/orders/payments: never dispatched to a carrier.
model PartnerSandboxStore {
  id           String                   @id @default(cuid())
  partnerId    String                   @unique
  name         String
  apiKeyHash   String                   @unique
  apiKey       String
  webhookToken String                   @unique @default(cuid())
  createdAt    DateTime                 @default(now())
  shipments    PartnerSandboxShipment[]
  partner      DeliveryPartner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_sandbox_stores")
}

model PartnerSandboxShipment {
  id             String                 @id @default(cuid())
  storeId        String
  idempotencyKey String
  trackingCode   String                 @unique
  status         PlatformShipmentStatus @default(REQUESTED)
  orderStatus    OrderStatus            @default(READY)
  events         Json                   @default("[]")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  store          PartnerSandboxStore    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, idempotencyKey])
  @@index([storeId, createdAt])
  @@map("partner_sandbox_shipments")
}

/// Single-use token for the forgot-password flow. Only a hash of the token
/// is stored — the raw token is emailed to the user and never persisted,
/// mirroring how passwordHash never stores a plaintext password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// WhatsApp OTP codes for phone-based signup confirmation. Only a hash of
/// the code is stored, same reasoning as PasswordResetToken.
model PhoneVerification {
  id         String    @id @default(cuid())
  userId     String
  phone      String
  codeHash   String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("phone_verifications")
}

/// OAuth / credentials accounts (NextAuth adapter)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Browser sessions (NextAuth adapter)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ============================================================================
// DISTRIBUTOR (الموزع)
// ============================================================================

/// A distributor manages multiple merchants and their stores on their behalf
model Distributor {
  id    String  @id @default(cuid())
  name  String
  slug  String  @unique
  email String?
  phone String?
  logo  String?

  status         DistributorStatus @default(PENDING)
  commissionRate Decimal           @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users              DistributorUser[]
  merchants          Merchant[]
  commissionPlans    CommissionPlan[]
  transactions       FinancialTransaction[]
  settlements        Settlement[]
  deliveryZones      DeliveryZone[]
  drivers            Driver[]
  deliveryCompanies  DeliveryCompany[]
  notificationLogs   DistributorNotificationLog[]
  featuredPlacements FeaturedPlacement[]

  @@index([slug])
  @@index([status])
  @@map("distributors")
}

/// External delivery company a distributor can hand off orders to
/// (as opposed to delivering with the distributor's own Driver fleet).
model DeliveryCompany {
  id            String  @id @default(cuid())
  distributorId String
  name          String
  contactName   String?
  phone         String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  distributor    Distributor             @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  deliveries     Delivery[]
  drivers        Driver[]
  merchants      Merchant[]              @relation("MerchantPreferredDeliveryCompany")
  providerConfig DeliveryProviderConfig?

  @@index([distributorId])
  @@map("delivery_companies")
}

/// Optional real-API integration for a DeliveryCompany — its absence means
/// the company is tracked manually (name/phone only, no automation), which
/// is still the default for every company today. `providerKey` selects
/// which adapter in src/modules/delivery-integrations handles this company
/// (see that module's registry). `credentials` is encrypted at rest — see
/// src/lib/crypto/secret.ts, same pattern as WhatsAppConfig.accessToken.
/// `webhookToken` is an unguessable per-company URL segment that routes an
/// inbound provider webhook back to this config, mirroring how
/// WhatsAppConfig.phoneNumberId routes the Meta webhook.
model DeliveryProviderConfig {
  id                String  @id @default(cuid())
  deliveryCompanyId String  @unique
  providerKey       String
  apiBaseUrl        String?
  credentials       String? // encrypted
  webhookToken      String  @unique @default(cuid())
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveryCompany DeliveryCompany @relation(fields: [deliveryCompanyId], references: [id], onDelete: Cascade)

  @@map("delivery_provider_configs")
}

/// Platform-contracted delivery operator. This is intentionally independent
/// from Distributor and becomes the ownership boundary for delivery supply.
model DeliveryPartner {
  id                      String                   @id @default(cuid())
  legacyDeliveryCompanyId String?                  @unique
  name                    String
  slug                    String                   @unique
  contactName             String?
  phone                   String?
  email                   String?
  description             String?
  logo                    String?
  website                 String?
  supportEmail            String?
  appName                 String?
  appDescription          String?
  appIcon                 String?
  appWebsite              String?
  privacyUrl              String?
  termsUrl                String?
  documentationUrl        String?
  appStatus               DeliveryPartnerAppStatus @default(DRAFT)
  status                  DeliveryPartnerStatus    @default(PENDING)
  supportsCod             Boolean                  @default(false)
  isActive                Boolean                  @default(true)
  rating                  Decimal                  @default(5) @db.Decimal(3, 2)
  completedDeliveries     Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  providerConfig      DeliveryPartnerProviderConfig?
  sandboxStore        PartnerSandboxStore?
  serviceAreas        DeliveryPartnerServiceArea[]
  pricingRules        DeliveryPartnerPricingRule[]
  couriers            DeliveryCourier[]
  quotes              DeliveryQuote[]
  shipments           PlatformShipment[]
  settlements         DeliveryPartnerSettlement[]
  users               DeliveryPartnerUser[]
  merchantConnections MerchantDeliveryPartner[]

  @@index([status, isActive])
  @@map("delivery_partners")
}

model DeliveryPartnerUser {
  id        String   @id @default(cuid())
  userId    String
  partnerId String
  role      UserRole
  isOwner   Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([userId, partnerId])
  @@index([partnerId, isActive])
  @@map("delivery_partner_users")
}

model MerchantDeliveryPartner {
  id         String   @id @default(cuid())
  merchantId String
  partnerId  String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  partner  DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([merchantId, partnerId])
  @@index([merchantId, isActive])
  @@index([partnerId, isActive])
  @@map("merchant_delivery_partners")
}

model DeliveryPartnerProviderConfig {
  id           String   @id @default(cuid())
  partnerId    String   @unique
  providerKey  String
  apiBaseUrl   String?
  credentials  String?
  webhookToken String   @unique @default(cuid())
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partner DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("delivery_partner_provider_configs")
}

model DeliveryPartnerServiceArea {
  id                  String   @id @default(cuid())
  partnerId           String
  code                String
  name                String
  city                String?
  centerLat           Float?
  centerLng           Float?
  radiusKm            Float?
  estimatedMinutesMin Int?
  estimatedMinutesMax Int?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  partner      DeliveryPartner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  pricingRules DeliveryPartnerPricingRule[]

  @@unique([partnerId, code])
  @@index([city, isActive])
  @@map("delivery_partner_service_areas")
}

model DeliveryPartnerPricingRule {
  id            String       @id @default(cuid())
  partnerId     String
  serviceAreaId String?
  vehicleType   VehicleType?
  baseFee       Decimal      @db.Decimal(10, 2)
  perKmFee      Decimal      @default(0) @db.Decimal(10, 2)
  minimumFee    Decimal      @default(0) @db.Decimal(10, 2)
  maximumFee    Decimal?     @db.Decimal(10, 2)
  maxDistanceKm Float?
  currency      String       @default("SDG")
  priority      Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  partner     DeliveryPartner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  serviceArea DeliveryPartnerServiceArea? @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  quotes      DeliveryQuote[]

  @@index([partnerId, isActive, priority])
  @@index([serviceAreaId])
  @@map("delivery_partner_pricing_rules")
}

/// Courier supply owned by a delivery partner or directly contracted by the
/// platform. Legacy drivers are copied only when they belonged to a verified
/// DeliveryCompany; distributor-fleet drivers require manual classification.
model DeliveryCourier {
  id             String       @id @default(cuid())
  partnerId      String?
  legacyDriverId String?      @unique
  name           String
  phone          String
  nationalId     String?
  photo          String?
  vehicleType    VehicleType  @default(MOTORCYCLE)
  vehiclePlate   String?
  status         DriverStatus @default(OFFLINE)
  isIndependent  Boolean      @default(false)
  isActive       Boolean      @default(true)
  isVerified     Boolean      @default(false)
  rating         Decimal      @default(5) @db.Decimal(3, 2)
  currentLat     Float?
  currentLng     Float?
  lastSeenAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  partner   DeliveryPartner?          @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  shipments PlatformShipment[]
  proofs    PlatformProofOfDelivery[]

  @@index([partnerId, status])
  @@index([phone])
  @@map("delivery_couriers")
}

model DeliveryQuote {
  id            String              @id @default(cuid())
  orderId       String
  partnerId     String
  pricingRuleId String?
  status        DeliveryQuoteStatus @default(OFFERED)
  distanceKm    Float
  fee           Decimal             @db.Decimal(10, 2)
  currency      String              @default("SDG")
  etaMinutesMin Int?
  etaMinutesMax Int?
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime            @default(now())

  order       Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partner     DeliveryPartner             @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  pricingRule DeliveryPartnerPricingRule? @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)
  shipment    PlatformShipment?

  @@index([orderId, status])
  @@index([partnerId, expiresAt])
  @@map("delivery_quotes")
}

model PlatformShipment {
  id                String                 @id @default(cuid())
  orderId           String                 @unique
  quoteId           String?                @unique
  partnerId         String
  courierId         String?
  trackingCode      String                 @unique
  providerReference String?
  status            PlatformShipmentStatus @default(REQUESTED)
  fee               Decimal                @db.Decimal(10, 2)
  currency          String                 @default("SDG")
  assignedAt        DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  order         Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quote         DeliveryQuote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  partner       DeliveryPartner          @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  courier       DeliveryCourier?         @relation(fields: [courierId], references: [id], onDelete: SetNull)
  events        DeliveryEvent[]
  proof         PlatformProofOfDelivery?
  codCollection CodCollection?

  @@index([partnerId, status])
  @@index([courierId, status])
  @@map("platform_shipments")
}

model DeliveryEvent {
  id         String                 @id @default(cuid())
  shipmentId String
  status     PlatformShipmentStatus
  note       String?
  actorType  String?
  actorId    String?
  metadata   Json?
  occurredAt DateTime               @default(now())

  shipment PlatformShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("delivery_events")
}

model PlatformProofOfDelivery {
  id            String   @id @default(cuid())
  shipmentId    String   @unique
  courierId     String?
  recipientName String?
  photoUrl      String?
  signatureUrl  String?
  otpVerified   Boolean  @default(false)
  notes         String?
  lat           Float?
  lng           Float?
  deliveredAt   DateTime @default(now())

  shipment PlatformShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  courier  DeliveryCourier? @relation(fields: [courierId], references: [id], onDelete: SetNull)

  @@map("platform_proofs_of_delivery")
}

model CodCollection {
  id              String              @id @default(cuid())
  shipmentId      String              @unique
  status          CodCollectionStatus @default(PENDING)
  expectedAmount  Decimal             @db.Decimal(10, 2)
  collectedAmount Decimal?            @db.Decimal(10, 2)
  remittedAmount  Decimal?            @db.Decimal(10, 2)
  currency        String              @default("SDG")
  collectedAt     DateTime?
  remittedAt      DateTime?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  shipment PlatformShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("cod_collections")
}

model DeliveryPartnerSettlement {
  id            String           @id @default(cuid())
  partnerId     String
  status        SettlementStatus @default(PENDING)
  periodFrom    DateTime
  periodTo      DateTime
  shipmentCount Int              @default(0)
  deliveryFees  Decimal          @default(0) @db.Decimal(12, 2)
  codCollected  Decimal          @default(0) @db.Decimal(12, 2)
  codRemitted   Decimal          @default(0) @db.Decimal(12, 2)
  netPayable    Decimal          @default(0) @db.Decimal(12, 2)
  currency      String           @default("SDG")
  paidAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  partner DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@unique([partnerId, periodFrom, periodTo])
  @@index([status, periodTo])
  @@map("delivery_partner_settlements")
}

/// Staff members of a distributor
model DistributorUser {
  id            String   @id @default(cuid())
  userId        String
  distributorId String
  role          UserRole

  isOwner  Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@unique([userId, distributorId])
  @@index([distributorId])
  @@index([userId])
  @@map("distributor_users")
}

// ============================================================================
// TENANT & ACCESS CONTROL
// ============================================================================

/// A merchant (business) is the primary tenant boundary
model Merchant {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  logo        String?
  coverImage  String?
  phone       String?
  email       String?
  address     String?

  businessType BusinessType
  storeType    StoreType      @default(ONLINE_STORE)
  status       MerchantStatus @default(PENDING)

  currency String @default("SDG")
  timezone String @default("Africa/Khartoum")

  isActive Boolean @default(true)

  // Optional: null means direct platform merchant (no distributor)
  distributorId String?

  // Finance
  commissionPlanId String?

  // Default external delivery company for this merchant's orders (optional)
  preferredDeliveryCompanyId String?

  // Set when a distributor invites a merchant by link (name + phone + location
  // only); cleared once the merchant completes their own registration.
  registrationToken          String?   @unique
  registrationTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  distributor                    Distributor?                         @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  commissionPlan                 CommissionPlan?                      @relation(fields: [commissionPlanId], references: [id], onDelete: SetNull)
  preferredDeliveryCompany       DeliveryCompany?                     @relation("MerchantPreferredDeliveryCompany", fields: [preferredDeliveryCompanyId], references: [id], onDelete: SetNull)
  users                          MerchantUser[]
  branches                       Branch[]
  products                       Product[]
  categories                     Category[]
  orders                         Order[]
  customers                      Customer[]
  inventoryItems                 InventoryItem[]
  storefrontSettings             StorefrontSettings?
  notificationLogs               NotificationLog[]
  roles                          Role[]
  transactions                   FinancialTransaction[]
  settlements                    Settlement[]
  promoCodes                     PromoCode[]
  loyaltyConfig                  LoyaltyConfig?
  conversations                  Conversation[]
  whatsappConfig                 WhatsAppConfig?
  featuredPlacements             FeaturedPlacement[]
  subscription                   MerchantSubscription?
  planChangeRequests             MerchantPlanChangeRequest[]
  subscriptionPayments           MerchantSubscriptionPayment[]
  storePaymentAccounts           MerchantPaymentAccount[]
  orderPaymentProofs             OrderPaymentProof[]
  whatsappAiUsage                WhatsAppAiUsage[]
  aiUsageBuckets                 AiUsageBucket[]
  aiUsageOperations              AiUsageOperation[]
  aiStoreProjects                MerchantAiStoreProject[]
  invoices                       Invoice[]
  deliveryPartnerConnections     MerchantDeliveryPartner[]
  complaints                     Complaint[]
  referralCode                   MerchantReferralCode?
  referralsMade                  MerchantReferral[]                   @relation("ReferralReferrer")
  referralReceived               MerchantReferral?                    @relation("ReferralReferred")
  referralRewards                MerchantReferralReward[]             @relation("ReferralRewardMerchant")
  referralCommissions            MerchantReferralCommission[]
  affiliateProgram               StoreAffiliateProgram?
  storeAffiliates                StoreAffiliate[]
  affiliateVisits                StoreAffiliateVisit[]
  affiliateAttributions          StoreAffiliateAttribution[]
  affiliateCommissions           StoreAffiliateCommission[]
  identityVerification           MerchantIdentityVerification?
  referralPayoutProfile          MerchantReferralPayoutProfile?
  customDomains                  MerchantDomain[]
  affiliateIdentityVerifications StoreAffiliateIdentityVerification[]
  subscriptionEvents            MerchantSubscriptionEvent[]
  affiliatePayoutProfiles        StoreAffiliatePayoutProfile[]
  marketerApplications           MarketerApplication[]

  @@index([slug])
  @@index([status])
  @@index([distributorId])
  @@index([commissionPlanId])
  @@map("merchants")
}

enum AiStoreVersionStatus {
  DRAFT
  APPLYING
  APPLIED
  PARTIAL
}

model MerchantAiStoreProject {
  id                   String   @id @default(cuid())
  merchantId           String
  gatewayProjectId     String?  @unique
  prompt               String
  provider             String
  providerRequestId    String?
  currentVersionNumber Int      @default(1)
  createdById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  merchant Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  versions MerchantAiStoreVersion[]

  @@index([merchantId, createdAt])
  @@map("merchant_ai_store_projects")
}

model MerchantAiStoreVersion {
  id                 String               @id @default(cuid())
  projectId          String
  gatewayVersionId   String?              @unique
  versionNumber      Int
  content            Json
  status             AiStoreVersionStatus @default(DRAFT)
  appliedAt          DateTime?
  applicationSummary Json?
  createdAt          DateTime             @default(now())

  project MerchantAiStoreProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, versionNumber])
  @@index([projectId, createdAt])
  @@map("merchant_ai_store_versions")
}

/// Platform-owned merchant acquisition policy. The single `merchant-growth`
/// row is created disabled by migration and must be explicitly configured.
model PlatformReferralProgram {
  id                String                    @id @default("merchant-growth")
  name              String                    @default("برنامج إحالة تجار وصلة")
  isActive          Boolean                   @default(false)
  qualificationRule ReferralQualificationRule @default(FIRST_PAID_PRO)
  rewardType        ReferralRewardType        @default(PRO_DAYS)
  rewardValue       Decimal                   @default(0) @db.Decimal(12, 2)
  currency          String?
  holdDays          Int                       @default(30)
  commissionRate    Decimal                   @default(20) @db.Decimal(5, 2)
  commissionMonths  Int                       @default(12)
  minimumPayout     Decimal                   @default(0) @db.Decimal(12, 2)
  terms             String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  referrals MerchantReferral[]

  @@map("platform_referral_programs")
}

model MerchantReferralCode {
  id         String   @id @default(cuid())
  merchantId String   @unique
  code       String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant  Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  referrals MerchantReferral[]

  @@index([code, isActive])
  @@map("merchant_referral_codes")
}

/// Immutable acquisition record. Commercial terms are snapshotted so future
/// program edits cannot rewrite a historical referral.
model MerchantReferral {
  id                        String                    @id @default(cuid())
  programId                 String
  referralCodeId            String
  referrerMerchantId        String
  referredMerchantId        String                    @unique
  codeSnapshot              String
  qualificationRuleSnapshot ReferralQualificationRule
  rewardTypeSnapshot        ReferralRewardType
  rewardValueSnapshot       Decimal                   @db.Decimal(12, 2)
  currencySnapshot          String?
  holdDaysSnapshot          Int
  commissionRateSnapshot    Decimal                   @default(20) @db.Decimal(5, 2)
  commissionMonthsSnapshot  Int                       @default(12)
  minimumPayoutSnapshot     Decimal                   @default(0) @db.Decimal(12, 2)
  identityFingerprint       String
  status                    MerchantReferralStatus    @default(REGISTERED)
  registeredAt              DateTime                  @default(now())
  activatedAt               DateTime?
  qualifiedAt               DateTime?
  rejectedAt                DateTime?
  rejectionReason           String?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  program          PlatformReferralProgram      @relation(fields: [programId], references: [id], onDelete: Restrict)
  referralCode     MerchantReferralCode         @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  referrerMerchant Merchant                     @relation("ReferralReferrer", fields: [referrerMerchantId], references: [id], onDelete: Restrict)
  referredMerchant Merchant                     @relation("ReferralReferred", fields: [referredMerchantId], references: [id], onDelete: Restrict)
  reward           MerchantReferralReward?
  commissions      MerchantReferralCommission[]

  @@index([referrerMerchantId, status, registeredAt])
  @@index([programId, status, registeredAt])
  @@index([identityFingerprint])
  @@map("merchant_referrals")
}

model MerchantReferralReward {
  id                 String               @id @default(cuid())
  referralId         String               @unique
  referrerMerchantId String
  type               ReferralRewardType
  value              Decimal              @db.Decimal(12, 2)
  currency           String?
  status             ReferralRewardStatus @default(PENDING)
  holdUntil          DateTime
  reviewedById       String?
  reviewedAt         DateTime?
  fulfilledAt        DateTime?
  fulfillmentRef     String?
  note               String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  referralRecord   MerchantReferral @relation(fields: [referralId], references: [id], onDelete: Restrict)
  referrerMerchant Merchant         @relation("ReferralRewardMerchant", fields: [referrerMerchantId], references: [id], onDelete: Restrict)

  @@index([referrerMerchantId, status, holdUntil])
  @@index([status, holdUntil])
  @@map("merchant_referral_rewards")
}

/// Recurring acquisition commission created only from a verified, paid,
/// non-FREE subscription invoice. Registration and free usage never earn cash.
model MerchantReferralCommission {
  id                    String               @id @default(cuid())
  referralId            String
  referrerMerchantId    String
  subscriptionPaymentId String               @unique
  grossAmount           Decimal              @db.Decimal(12, 2)
  commissionRate        Decimal              @db.Decimal(5, 2)
  amount                Decimal              @db.Decimal(12, 2)
  currency              String
  minimumPayoutSnapshot Decimal              @db.Decimal(12, 2)
  status                ReferralRewardStatus @default(PENDING)
  holdUntil             DateTime
  reviewedById          String?
  reviewedAt            DateTime?
  fulfilledAt           DateTime?
  fulfillmentRef        String?
  reversedAt            DateTime?
  note                  String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  referralRecord      MerchantReferral            @relation(fields: [referralId], references: [id], onDelete: Restrict)
  referrerMerchant    Merchant                    @relation(fields: [referrerMerchantId], references: [id], onDelete: Restrict)
  subscriptionPayment MerchantSubscriptionPayment @relation(fields: [subscriptionPaymentId], references: [id], onDelete: Restrict)

  @@index([referrerMerchantId, status, holdUntil])
  @@index([referralId, createdAt])
  @@map("merchant_referral_commissions")
}

/// Merchant-owned storefront affiliate policy. It is created inactive so a
/// merchant cannot incur commission liability before explicitly configuring it.
model StoreAffiliateProgram {
  id              String   @id @default(cuid())
  merchantId      String   @unique
  isActive        Boolean  @default(false)
  commissionRate  Decimal  @default(0) @db.Decimal(5, 2)
  attributionDays Int      @default(30)
  holdDays        Int      @default(14)
  minimumPayout   Decimal  @default(0) @db.Decimal(12, 2)
  currency        String   @default("SDG")
  terms           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  merchant     Merchant                    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  affiliates   StoreAffiliate[]
  visits       StoreAffiliateVisit[]
  attributions StoreAffiliateAttribution[]

  @@map("store_affiliate_programs")
}

model StoreAffiliate {
  id                       String               @id @default(cuid())
  merchantId               String
  programId                String
  name                     String
  phone                    String
  email                    String?
  code                     String
  status                   StoreAffiliateStatus @default(ACTIVE)
  onboardingTokenHash      String?              @unique
  onboardingTokenExpiresAt DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  merchant             Merchant                            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  program              StoreAffiliateProgram               @relation(fields: [programId], references: [id], onDelete: Cascade)
  visits               StoreAffiliateVisit[]
  attributions         StoreAffiliateAttribution[]
  commissions          StoreAffiliateCommission[]
  identityVerification StoreAffiliateIdentityVerification?
  payoutProfile        StoreAffiliatePayoutProfile?
  marketerApplication  MarketerApplication?

  @@unique([merchantId, code])
  @@unique([merchantId, phone])
  @@index([merchantId, status, createdAt])
  @@map("store_affiliates")
}

/// Public marketer application. Acquisition applications are reviewed by
/// WASLA; product applications are tenant-scoped and reviewed by the store.
model MarketerApplication {
  id              String                    @id @default(cuid())
  applicationKey  String                    @unique
  type            MarketerApplicationType
  merchantId      String?
  name            String
  phone           String
  email           String
  city            String
  channels        String[]
  experience      String?
  audienceSize    Int?
  portfolioUrl    String?
  notes           String?
  status          MarketerApplicationStatus @default(PENDING)
  affiliateId     String?                   @unique
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  termsAcceptedAt DateTime
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  merchant  Merchant?       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  affiliate StoreAffiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)

  @@index([type, status, createdAt])
  @@index([merchantId, status, createdAt])
  @@index([phone])
  @@map("marketer_applications")
}

/// Merchant KYC record. Document numbers and files are never public: numbers
/// are encrypted and file bytes live in private storage.
model MerchantIdentityVerification {
  id                      String                     @id @default(cuid())
  merchantId              String                     @unique
  legalName               String
  documentType            IdentityDocumentType
  documentNumberEncrypted String
  expiresAt               DateTime
  status                  IdentityVerificationStatus @default(DRAFT)
  submittedAt             DateTime?
  reviewedById            String?
  reviewedAt              DateTime?
  rejectionReason         String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  merchant  Merchant                   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  documents MerchantIdentityDocument[]

  @@index([status, submittedAt])
  @@map("merchant_identity_verifications")
}

model MerchantIdentityDocument {
  id             String               @id @default(cuid())
  verificationId String
  side           IdentityDocumentSide
  storageKey     String               @unique
  fileName       String
  mimeType       String
  size           Int
  sha256         String
  createdAt      DateTime             @default(now())

  verification MerchantIdentityVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@unique([verificationId, side])
  @@index([verificationId])
  @@map("merchant_identity_documents")
}

model StoreAffiliateIdentityVerification {
  id                      String                     @id @default(cuid())
  merchantId              String
  affiliateId             String                     @unique
  legalName               String
  documentType            IdentityDocumentType
  documentNumberEncrypted String
  expiresAt               DateTime
  status                  IdentityVerificationStatus @default(DRAFT)
  submittedAt             DateTime?
  reviewedById            String?
  reviewedAt              DateTime?
  rejectionReason         String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  merchant  Merchant                         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  affiliate StoreAffiliate                   @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  documents StoreAffiliateIdentityDocument[]

  @@index([merchantId, status, submittedAt])
  @@index([status, submittedAt])
  @@map("store_affiliate_identity_verifications")
}

model StoreAffiliateIdentityDocument {
  id             String               @id @default(cuid())
  verificationId String
  side           IdentityDocumentSide
  storageKey     String               @unique
  fileName       String
  mimeType       String
  size           Int
  sha256         String
  createdAt      DateTime             @default(now())

  verification StoreAffiliateIdentityVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@unique([verificationId, side])
  @@index([verificationId])
  @@map("store_affiliate_identity_documents")
}

/// The merchant is the referrer in the current acquisition program. Financial
/// coordinates are encrypted and only masked values are returned to the UI.
model MerchantReferralPayoutProfile {
  id                     String       @id @default(cuid())
  merchantId             String       @unique
  method                 PayoutMethod
  bankName               String?
  accountNameEncrypted   String
  accountNumberEncrypted String
  ibanEncrypted          String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_referral_payout_profiles")
}

model StoreAffiliatePayoutProfile {
  id                     String       @id @default(cuid())
  merchantId             String
  affiliateId            String       @unique
  method                 PayoutMethod
  bankName               String?
  accountNameEncrypted   String
  accountNumberEncrypted String
  ibanEncrypted          String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  merchant  Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  affiliate StoreAffiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("store_affiliate_payout_profiles")
}

/// A custom hostname remains inert until DNS ownership is verified and a
/// platform operator activates it after TLS/routing validation.
model MerchantDomain {
  id                String               @id @default(cuid())
  merchantId        String               @unique
  hostname          String               @unique
  verificationToken String
  status            MerchantDomainStatus @default(PENDING_DNS)
  dnsVerifiedAt     DateTime?
  activatedAt       DateTime?
  reviewedById      String?
  rejectionReason   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, status])
  @@index([status, createdAt])
  @@map("merchant_domains")
}

/// One pseudonymous last-click token. The raw token exists only in the
/// browser's HttpOnly cookie; the database stores its keyed fingerprint.
model StoreAffiliateVisit {
  id          String   @id @default(cuid())
  merchantId  String
  programId   String
  affiliateId String
  tokenHash   String   @unique
  visitedAt   DateTime @default(now())
  expiresAt   DateTime

  merchant     Merchant                    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  program      StoreAffiliateProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  affiliate    StoreAffiliate              @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  attributions StoreAffiliateAttribution[]

  @@index([merchantId, affiliateId, visitedAt])
  @@index([expiresAt])
  @@map("store_affiliate_visits")
}

/// Immutable order attribution with commercial terms snapshotted at checkout.
model StoreAffiliateAttribution {
  id                     String                          @id @default(cuid())
  merchantId             String
  programId              String
  affiliateId            String
  visitId                String?
  orderId                String                          @unique
  codeSnapshot           String
  commissionRateSnapshot Decimal                         @db.Decimal(5, 2)
  baseAmount             Decimal                         @db.Decimal(12, 2)
  currencySnapshot       String
  holdDaysSnapshot       Int
  minimumPayoutSnapshot  Decimal                         @db.Decimal(12, 2)
  status                 StoreAffiliateAttributionStatus @default(ATTRIBUTED)
  attributedAt           DateTime                        @default(now())
  voidedAt               DateTime?
  voidReason             String?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  merchant   Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  program    StoreAffiliateProgram     @relation(fields: [programId], references: [id], onDelete: Restrict)
  affiliate  StoreAffiliate            @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  visit      StoreAffiliateVisit?      @relation(fields: [visitId], references: [id], onDelete: SetNull)
  order      Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  commission StoreAffiliateCommission?

  @@index([merchantId, affiliateId, status, attributedAt])
  @@index([visitId])
  @@map("store_affiliate_attributions")
}

model StoreAffiliateCommission {
  id            String                         @id @default(cuid())
  merchantId    String
  affiliateId   String
  attributionId String                         @unique
  orderId       String                         @unique
  amount        Decimal                        @db.Decimal(12, 2)
  currency      String
  status        StoreAffiliateCommissionStatus @default(PENDING)
  holdUntil     DateTime
  reviewedById  String?
  reviewedAt    DateTime?
  paidAt        DateTime?
  paymentRef    String?
  reversedAt    DateTime?
  note          String?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt

  merchant    Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  affiliate   StoreAffiliate            @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  attribution StoreAffiliateAttribution @relation(fields: [attributionId], references: [id], onDelete: Restrict)
  order       Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([merchantId, status, holdUntil])
  @@index([affiliateId, status, createdAt])
  @@map("store_affiliate_commissions")
}

/// Join between User and Merchant — carries the user's role within a merchant
model MerchantUser {
  id         String   @id @default(cuid())
  userId     String
  merchantId String
  roleId     String?
  role       UserRole

  isOwner  Boolean @default(false)
  isActive Boolean @default(true)

  branchId String? // Optional: scope staff to a specific branch

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant     Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  assignedRole Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, merchantId])
  @@index([merchantId])
  @@index([userId])
  @@index([branchId])
  @@map("merchant_users")
}

/// Platform-owned SaaS plan. This replaces distributor-owned commission plans
/// as the source of product access for direct merchants.
model MerchantPlan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  monthlyPrice Decimal  @default(0) @db.Decimal(10, 2)
  yearlyPrice  Decimal? @db.Decimal(10, 2)
  currency     String   @default("USD")
  entitlements Json
  isPublic     Boolean  @default(true)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions  MerchantSubscription[]
  changeRequests MerchantPlanChangeRequest[]
  payments       MerchantSubscriptionPayment[]

  @@index([isActive, sortOrder])
  @@map("merchant_plans")
}

/// Current SaaS subscription for a merchant. One row per merchant keeps plan
/// checks cheap while preserving a safe path to direct platform billing.
model MerchantSubscription {
  id                    String                     @id @default(cuid())
  merchantId            String                     @unique
  planId                String
  status                MerchantSubscriptionStatus @default(ACTIVE)
  billingInterval        SubscriptionBillingInterval @default(MONTHLY)
  startsAt              DateTime                   @default(now())
  trialStartedAt        DateTime?
  trialEndsAt           DateTime?
  currentPeriodStartsAt DateTime?
  currentPeriodEndsAt   DateTime?
  graceEndsAt           DateTime?
  cancelAtPeriodEnd     Boolean                    @default(false)
  cancelledAt           DateTime?
  priceOverride         Decimal?                   @db.Decimal(10, 2)
  currencyOverride      String?
  entitlementOverrides   Json?
  billingProvider        String?
  externalCustomerId     String?
  externalSubscriptionId String?                    @unique
  isGrandfathered       Boolean                    @default(false)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  merchant Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  plan     MerchantPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  events   MerchantSubscriptionEvent[]

  @@index([planId, status])
  @@index([status, currentPeriodEndsAt])
  @@index([billingProvider, externalCustomerId])
  @@map("merchant_subscriptions")
}

/// Append-only commercial lifecycle audit trail. Metadata must not contain
/// payment credentials or raw webhook bodies.
model MerchantSubscriptionEvent {
  id             String   @id @default(cuid())
  merchantId     String
  subscriptionId String?
  type           String
  source         String
  actorId        String?
  metadata       Json?
  occurredAt     DateTime @default(now())

  merchant     Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  subscription MerchantSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([merchantId, occurredAt])
  @@index([subscriptionId, occurredAt])
  @@map("merchant_subscription_events")
}

/// Idempotency ledger for verified external billing events. The raw body is
/// deliberately not persisted; only its SHA-256 fingerprint is retained.
model BillingWebhookEvent {
  id              String                    @id @default(cuid())
  provider        String
  externalEventId String
  eventType       String
  payloadSha256   String
  status          BillingWebhookEventStatus @default(RECEIVED)
  errorMessage    String?
  receivedAt      DateTime                  @default(now())
  processedAt     DateTime?

  @@unique([provider, externalEventId])
  @@index([status, receivedAt])
  @@map("billing_webhook_events")
}

/// Merchant-initiated plan change request. This provides a safe internal
/// review path before external recurring billing is connected.
model MerchantPlanChangeRequest {
  id           String                          @id @default(cuid())
  merchantId   String
  targetPlanId String
  requestKey   String?                         @unique
  status       MerchantPlanChangeRequestStatus @default(PENDING)
  note         String?
  createdAt    DateTime                        @default(now())
  updatedAt    DateTime                        @updatedAt
  resolvedAt   DateTime?

  merchant   Merchant                      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  targetPlan MerchantPlan                  @relation(fields: [targetPlanId], references: [id], onDelete: Restrict)
  payments   MerchantSubscriptionPayment[]

  @@index([merchantId, status])
  @@index([status, createdAt])
  @@map("merchant_plan_change_requests")
}

model PlatformPaymentAccount {
  id            String               @id @default(cuid())
  channel       ManualPaymentChannel
  label         String
  accountName   String
  accountNumber String
  instructions  String?
  monthlyAmount Decimal              @db.Decimal(12, 2)
  currency      String               @default("SDG")
  isActive      Boolean              @default(true)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  payments MerchantSubscriptionPayment[]

  @@index([isActive, sortOrder])
  @@map("platform_payment_accounts")
}

/// Merchant proof for a WASLA plan transfer. Evidence lives in private storage.
model MerchantSubscriptionPayment {
  id                  String                    @id @default(cuid())
  merchantId          String
  targetPlanId        String
  planChangeRequestId String?
  paymentAccountId    String
  amount              Decimal                   @db.Decimal(12, 2)
  currency            String
  channel             ManualPaymentChannel
  transactionRef      String
  senderName          String?
  transferredAt       DateTime?
  proofStorageKey     String
  proofMimeType       String
  proofSize           Int
  proofSha256         String
  status              ManualPaymentReviewStatus @default(PENDING)
  reviewedById        String?
  reviewedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  merchant           Merchant                    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  targetPlan         MerchantPlan                @relation(fields: [targetPlanId], references: [id], onDelete: Restrict)
  planChangeRequest  MerchantPlanChangeRequest?  @relation(fields: [planChangeRequestId], references: [id], onDelete: SetNull)
  paymentAccount     PlatformPaymentAccount      @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)
  referralCommission MerchantReferralCommission?

  @@unique([paymentAccountId, transactionRef])
  @@unique([merchantId, proofSha256])
  @@index([merchantId, status, createdAt])
  @@index([status, createdAt])
  @@map("merchant_subscription_payments")
}

/// Custom role definition — merchant-scoped or system-wide
model Role {
  id          String  @id @default(cuid())
  name        String
  description String?
  merchantId  String? // null = system-wide role

  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  permissions   RolePermission[]
  merchantUsers MerchantUser[]
  merchant      Merchant?        @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("roles")
}

/// Granular permission definition (system-managed)
model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  module      String // e.g. "orders", "products", "inventory"
  action      String // e.g. "create", "read", "update", "delete"
  description String?

  // Relations
  roles RolePermission[]

  @@map("permissions")
}

/// Many-to-many join between Role and Permission
model RolePermission {
  roleId       String
  permissionId String

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================================================
// BRANCHES
// ============================================================================

/// Physical branch / location belonging to a merchant
model Branch {
  id         String  @id @default(cuid())
  merchantId String
  name       String
  address    String?
  phone      String?
  email      String?
  lat        Float?
  lng        Float?

  isMain   Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  merchant       Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantUsers  MerchantUser[]
  inventoryItems InventoryItem[]
  orders         Order[]

  @@index([merchantId])
  @@map("branches")
}

// ============================================================================
// CATALOG
// ============================================================================

/// Product category — supports self-referencing parent/child hierarchy
model Category {
  id          String  @id @default(cuid())
  merchantId  String
  name        String
  slug        String
  description String?
  image       String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  parentId String? // Self-relation for subcategories

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  merchant Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products Product[]
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  @@unique([merchantId, slug])
  @@index([merchantId])
  @@index([parentId])
  @@map("categories")
}

/// A product listed in the merchant's catalog
model Product {
  id         String @id @default(cuid())
  merchantId String
  categoryId String

  name        String
  slug        String
  description String?
  images      Json    @default("[]") // Array of image URLs

  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2) // Strike-through / original price

  sku     String?
  barcode String?

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  merchant      Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modifiers     ProductModifier[]
  inventoryItem InventoryItem?
  orderItems    OrderItem[]

  @@unique([merchantId, slug])
  @@index([merchantId])
  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

/// Modifier group for a product (e.g. "Size", "Add-ons")
model ProductModifier {
  id        String  @id @default(cuid())
  productId String
  name      String
  required  Boolean @default(false)

  minSelections Int @default(0)
  maxSelections Int @default(1)

  options Json // Array of { name: string, price: number }

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_modifiers")
}

// ============================================================================
// INVENTORY
// ============================================================================

/// Tracks stock level for a single product (optionally per-branch)
model InventoryItem {
  id         String  @id @default(cuid())
  productId  String  @unique
  merchantId String
  branchId   String?

  quantity         Int @default(0)
  reservedQuantity Int @default(0)

  lowStockThreshold Int     @default(5)
  trackInventory    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchant       Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]

  @@index([merchantId])
  @@index([branchId])
  @@index([productId])
  @@map("inventory_items")
}

/// Immutable log of every stock change
model StockMovement {
  id              String            @id @default(cuid())
  inventoryItemId String
  type            StockMovementType

  quantity         Int // Can be negative (e.g. sale, damage)
  previousQuantity Int
  newQuantity      Int

  reason    String? // Human-readable reason
  reference String? // e.g. order number

  createdById String? // userId who made the change

  createdAt DateTime @default(now())

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

// ============================================================================
// CUSTOMERS
// ============================================================================

/// A customer scoped to a single merchant (CRM-style)
model Customer {
  id         String          @id @default(cuid())
  merchantId String
  accountId  String?
  name       String
  phone      String
  email      String?
  notes      String?
  address    String?
  segment    CustomerSegment @default(NEW)
  isBlocked  Boolean         @default(false)

  totalOrders Int       @default(0)
  totalSpent  Decimal   @default(0) @db.Decimal(10, 2)
  lastOrderAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  merchant       Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  account        CustomerAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  addresses      CustomerAddress[]
  orders         Order[]
  loyaltyAccount LoyaltyAccount?

  @@unique([merchantId, phone])
  @@index([merchantId])
  @@index([phone])
  @@index([segment])
  @@index([accountId])
  @@map("customers")
}

/// Global end-customer identity for the Flutter app — distinct from the
/// merchant-scoped `Customer` CRM record and from the staff `User` model
/// (whose `email` is required/unique and unrelated to app customers).
/// One account can be linked to several per-merchant `Customer` rows.
model CustomerAccount {
  id           String  @id @default(cuid())
  phone        String  @unique
  passwordHash String
  name         String
  fcmToken     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  customers       Customer[]
  subscriptions   CustomerSubscription[]
  refreshSessions CustomerRefreshSession[]

  @@map("customer_accounts")
}

/// Revocable mobile-app session. Only a SHA-256 hash of the opaque refresh
/// token is persisted. Rotated tokens share a family so reuse can revoke the
/// whole compromised session chain.
model CustomerRefreshSession {
  id        String @id @default(cuid())
  accountId String
  familyId  String
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  account CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("customer_refresh_sessions")
}

enum CustomerSubscriptionStatus {
  ACTIVE
  CANCELLED
}

enum MerchantSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  CANCELLED
}

enum SubscriptionBillingInterval {
  MONTHLY
  YEARLY
  CUSTOM
}

enum BillingWebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

enum AiUsageOperationStatus {
  RESERVED
  COMMITTED
  RELEASED
  EXPIRED
}

enum MerchantPlanChangeRequestStatus {
  PENDING
  CONTACTED
  COMPLETED
  REJECTED
  CANCELLED
}

enum ManualPaymentChannel {
  BANKAK
  MYCASHY
  OTHER
}

enum ManualPaymentReviewStatus {
  PENDING
  VERIFIED
  REJECTED
  CANCELLED
}

/// Platform-wide delivery-perk subscription for a Flutter-app CustomerAccount
/// (spans every merchant, unlike the per-merchant Customer/LoyaltyAccount
/// records) — e.g. a paid "delivery pass". No payment gateway is integrated
/// yet, so grants are manual (platform admin), not self-serve billing;
/// `grantedById` is a loose reference to the granting User, same pattern as
/// other audit fields in this schema (createdById, changedById, ...).
model CustomerSubscription {
  id                String                     @id @default(cuid())
  customerAccountId String
  plan              String                     @default("FREE_DELIVERY")
  status            CustomerSubscriptionStatus @default(ACTIVE)
  startsAt          DateTime
  endsAt            DateTime
  grantedById       String?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId])
  @@index([startsAt, endsAt])
  @@map("customer_subscriptions")
}

/// Saved delivery address for a customer
model CustomerAddress {
  id         String  @id @default(cuid())
  customerId String
  label      String // e.g. "Home", "Work"
  address    String
  area       String?
  city       String?
  lat        Float?
  lng        Float?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

// ============================================================================
// ORDERS
// ============================================================================

/// The central order entity — scoped to a merchant
model Order {
  id          String  @id @default(cuid())
  merchantId  String
  orderNumber String
  customerId  String
  branchId    String?

  status OrderStatus @default(NEW)

  subtotal    Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  tax         Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  deliveryMethod DeliveryMethod @default(PICKUP)
  paymentMethod  PaymentMethod  @default(CASH)

  notes         String?
  internalNotes String?

  // Denormalized customer snapshot (in case customer record changes)
  customerName    String?
  customerPhone   String?
  customerAddress String?

  estimatedReadyAt DateTime?
  completedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  merchant             Merchant                   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer             Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch               Branch?                    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  delivery             Delivery?
  payment              Payment?
  proofOfDelivery      ProofOfDelivery?
  deliveryQuotes       DeliveryQuote[]
  platformShipment     PlatformShipment?
  invoice              Invoice?
  complaints           Complaint[]
  affiliateAttribution StoreAffiliateAttribution?
  affiliateCommission  StoreAffiliateCommission?

  @@unique([merchantId, orderNumber])
  @@index([merchantId])
  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@index([orderNumber])
  @@map("orders")
}

/// Line item within an order — stores a snapshot of the product at order time
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String? // May be null if product was deleted

  productSnapshot Json // { name, price, image } at time of order

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  modifiers Json? // Selected modifiers with prices
  notes     String?

  createdAt DateTime @default(now())

  // Relations
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Immutable commercial invoice snapshot generated from an order.
model Invoice {
  id            String        @id @default(cuid())
  merchantId    String
  orderId       String        @unique
  invoiceNumber String
  publicToken   String        @unique @default(uuid())
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("SDG")

  subtotal    Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  tax         Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  customerName   String?
  customerPhone  String?
  customerEmail  String?
  billingAddress String?
  notes          String?
  issuedAt       DateTime?
  paidAt         DateTime?
  voidedAt       DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  merchant Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order    Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]

  @@unique([merchantId, invoiceNumber])
  @@index([merchantId, status])
  @@index([merchantId, createdAt])
  @@map("invoices")
}

/// Line-item snapshot; it remains valid even if the product is later edited.
model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  orderItemId String?
  description String
  sku         String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

/// Immutable audit trail of order status transitions
model OrderStatusHistory {
  id      String      @id @default(cuid())
  orderId String
  status  OrderStatus

  note        String?
  changedById String? // userId

  createdAt DateTime @default(now())

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_history")
}

// ============================================================================
// DELIVERY & PAYMENT
// ============================================================================

/// Delivery details attached to an order (1-to-1)
model Delivery {
  id      String         @id @default(cuid())
  orderId String         @unique
  type    DeliveryMethod
  status  DeliveryStatus @default(PENDING)

  address String?
  area    String?
  city    String?
  lat     Float?
  lng     Float?

  driverName  String?
  driverPhone String?

  // Set when handed off to an external delivery company instead of an
  // internal Driver — the two are mutually exclusive in practice.
  deliveryCompanyId String?

  // The external provider's own shipment/tracking ID, set once
  // delivery-integrations successfully creates a shipment with them. Null
  // means either no integration is configured for this company, or the
  // shipment call hasn't happened/succeeded yet.
  providerReference String?

  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?

  fee   Decimal @default(0) @db.Decimal(10, 2)
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryCompany DeliveryCompany? @relation(fields: [deliveryCompanyId], references: [id], onDelete: SetNull)

  @@index([providerReference])
  @@map("deliveries")
}

/// Payment record attached to an order (1-to-1)
model Payment {
  id      String        @id @default(cuid())
  orderId String        @unique
  method  PaymentMethod
  status  PaymentStatus @default(PENDING)

  amount         Decimal   @db.Decimal(10, 2)
  transactionRef String?
  paidAt         DateTime?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  manualProof OrderPaymentProof?

  @@map("payments")
}

/// A merchant-owned transfer destination displayed only on that merchant's checkout.
model MerchantPaymentAccount {
  id            String               @id @default(cuid())
  merchantId    String
  channel       ManualPaymentChannel
  label         String
  accountName   String
  accountNumber String
  instructions  String?
  isActive      Boolean              @default(true)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  merchant Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  proofs   OrderPaymentProof[]

  @@index([merchantId, isActive, sortOrder])
  @@map("merchant_payment_accounts")
}

/// Private transfer evidence attached to a storefront order payment.
model OrderPaymentProof {
  id                       String                    @id @default(cuid())
  merchantId               String
  paymentId                String                    @unique
  merchantPaymentAccountId String?
  channel                  ManualPaymentChannel
  accountLabel             String
  accountNumber            String
  transactionRef           String
  senderName               String?
  transferredAt            DateTime?
  proofStorageKey          String
  proofMimeType            String
  proofSize                Int
  proofSha256              String
  status                   ManualPaymentReviewStatus @default(PENDING)
  reviewedById             String?
  reviewedAt               DateTime?
  rejectionReason          String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  merchant       Merchant                @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payment        Payment                 @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentAccount MerchantPaymentAccount? @relation(fields: [merchantPaymentAccountId], references: [id], onDelete: SetNull)

  @@unique([merchantPaymentAccountId, transactionRef])
  @@unique([merchantId, proofSha256])
  @@index([merchantId, status, createdAt])
  @@map("order_payment_proofs")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

/// Log of every notification sent within a merchant's scope
model NotificationLog {
  id         String              @id @default(cuid())
  merchantId String
  type       NotificationType
  channel    NotificationChannel

  recipient String // phone, email, or userId
  title     String
  body      String

  isRead         Boolean @default(false)
  metadata       Json?
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  // Relations
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("notification_logs")
}

/// Log of every notification sent within a distributor's scope
model DistributorNotificationLog {
  id            String                      @id @default(cuid())
  distributorId String
  type          DistributorNotificationType
  channel       NotificationChannel         @default(IN_APP)

  title String
  body  String

  isRead   Boolean @default(false)
  metadata Json?

  createdAt DateTime @default(now())

  // Relations
  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([distributorId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("distributor_notification_logs")
}

/// Log of notifications shared across all platform admins (no per-admin scoping)
model PlatformNotificationLog {
  id      String                   @id @default(cuid())
  type    PlatformNotificationType
  channel NotificationChannel      @default(IN_APP)

  title String
  body  String

  isRead   Boolean @default(false)
  metadata Json?

  createdAt DateTime @default(now())

  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("platform_notification_logs")
}

enum OutboxJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Durable work queue for notifications, billing, and other retryable side effects.
model OutboxJob {
  id             String          @id @default(cuid())
  topic          String
  payload        Json
  idempotencyKey String          @unique
  status         OutboxJobStatus @default(PENDING)
  attempts       Int             @default(0)
  maxAttempts    Int             @default(5)
  availableAt    DateTime        @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, availableAt])
  @@index([status, lockedAt])
  @@index([topic, status])
  @@map("outbox_jobs")
}

// ============================================================================
// STOREFRONT
// ============================================================================

/// Per-merchant storefront configuration (1-to-1 with Merchant)
model StorefrontSettings {
  id         String @id @default(cuid())
  merchantId String @unique

  theme       Json? // { primaryColor, accentColor, layout, ... }
  bannerImage String?
  welcomeText String?

  isOpen Boolean @default(true)

  minimumOrderAmount Decimal @default(0) @db.Decimal(10, 2)

  deliveryEnabled Boolean @default(true)
  pickupEnabled   Boolean @default(true)

  workingHours Json? // { sunday: { open: "09:00", close: "22:00" }, ... }
  socialLinks  Json? // { facebook, instagram, twitter, whatsapp }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("storefront_settings")
}

// ============================================================================
// FINANCE — Commission Plans, Transactions, Settlements, Delivery Zones
// ============================================================================

enum CommissionType {
  PERCENTAGE
  FLAT_FEE
  HYBRID
  SUBSCRIPTION
}

enum TransactionType {
  COMMISSION
  SUBSCRIPTION_FEE
  DELIVERY_FEE
  ADJUSTMENT
  REFUND
  SETTLEMENT_PAYOUT
  FEATURED_PLACEMENT_FEE
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Commission plan defines how a distributor charges merchants
model CommissionPlan {
  id            String         @id @default(cuid())
  distributorId String
  name          String
  description   String?
  type          CommissionType
  rate          Decimal        @db.Decimal(5, 2)
  minFee        Decimal        @default(0) @db.Decimal(10, 2)
  currency      String         @default("SDG")
  isDefault     Boolean        @default(false)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  merchants   Merchant[]

  @@index([distributorId])
  @@map("commission_plans")
}

/// Immutable financial transaction log (distributor-scoped)
model FinancialTransaction {
  id            String  @id @default(cuid())
  distributorId String
  merchantId    String?
  orderId       String?
  settlementId  String?

  type      TransactionType
  direction TransactionDirection
  amount    Decimal              @db.Decimal(10, 2)
  currency  String               @default("SDG")

  description String?
  reference   String?
  metadata    Json?

  createdAt DateTime @default(now())

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  merchant    Merchant?   @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  settlement  Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([distributorId])
  @@index([merchantId])
  @@index([type])
  @@index([createdAt])
  @@map("financial_transactions")
}

/// Settlement batch — summarises a merchant's payable balance for a period
model Settlement {
  id            String           @id @default(cuid())
  distributorId String
  merchantId    String
  status        SettlementStatus @default(PENDING)
  totalOrders   Int              @default(0)
  grossAmount   Decimal          @db.Decimal(10, 2)
  commission    Decimal          @db.Decimal(10, 2)
  fees          Decimal          @default(0) @db.Decimal(10, 2)
  netAmount     Decimal          @db.Decimal(10, 2)
  currency      String           @default("SDG")
  periodFrom    DateTime
  periodTo      DateTime
  notes         String?
  paidAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  distributor  Distributor            @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  merchant     Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]

  @@unique([merchantId, periodFrom, periodTo])
  @@index([distributorId])
  @@index([merchantId])
  @@index([status])
  @@map("settlements")
}

/// Delivery zone with pricing — used for last-mile fee calculation
model DeliveryZone {
  id            String   @id @default(cuid())
  distributorId String
  name          String
  description   String?
  baseFee       Decimal  @db.Decimal(10, 2)
  perKmFee      Decimal  @default(0) @db.Decimal(10, 2)
  maxDistanceKm Float?
  estimatedTime String?
  currency      String   @default("SDG")
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([distributorId])
  @@map("delivery_zones")
}

/// Paid boosted placement for a merchant in the customer-app discovery feed
/// (see storefront.repository.ts listActiveMerchants / GET /api/stores/featured).
/// Sold by the distributor to a merchant in their own portfolio for a fixed
/// window — not a subscription, each placement is its own paid slot so a
/// merchant can run several non-contiguous campaigns over time.
model FeaturedPlacement {
  id            String   @id @default(cuid())
  merchantId    String
  distributorId String
  startsAt      DateTime
  endsAt        DateTime
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("SDG")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  merchant    Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([distributorId])
  @@index([startsAt, endsAt])
  @@map("featured_placements")
}

// ============================================================================
// DRIVERS — Driver Management & Real-time Tracking
// ============================================================================

enum DriverStatus {
  OFFLINE
  ONLINE
  BUSY
  ON_BREAK
}

enum VehicleType {
  MOTORCYCLE
  CAR
  BICYCLE
  VAN
}

model Driver {
  id                String       @id @default(cuid())
  distributorId     String
  deliveryCompanyId String?
  name              String
  phone             String
  nationalId        String?
  photo             String?
  vehicleType       VehicleType  @default(MOTORCYCLE)
  vehiclePlate      String?
  status            DriverStatus @default(OFFLINE)
  isActive          Boolean      @default(true)
  isVerified        Boolean      @default(false)
  rating            Decimal      @default(5.0) @db.Decimal(3, 2)
  totalDeliveries   Int          @default(0)
  currentLat        Float?
  currentLng        Float?
  lastSeenAt        DateTime?
  notes             String?
  // Bearer credential for POST /api/driver/location — the driver-side
  // app/device authenticates with this instead of a raw, guessable driverId.
  // Not hashed (same trust model as Merchant.registrationToken /
  // DeliveryProviderConfig.webhookToken): needs to stay legible so a
  // distributor can re-share it if a driver's device is reconfigured.
  locationToken     String       @unique @default(cuid())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  distributor      Distributor         @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  deliveryCompany  DeliveryCompany?    @relation(fields: [deliveryCompanyId], references: [id], onDelete: SetNull)
  assignments      DriverAssignment[]
  locationLogs     DriverLocationLog[]
  earnings         DriverEarning[]
  proofsOfDelivery ProofOfDelivery[]

  @@unique([distributorId, phone])
  @@index([distributorId])
  @@index([status])
  @@map("drivers")
}

model DriverAssignment {
  id          String    @id @default(cuid())
  driverId    String
  orderId     String    @unique
  assignedAt  DateTime  @default(now())
  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  notes       String?

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([orderId])
  @@map("driver_assignments")
}

model DriverLocationLog {
  id        String   @id @default(cuid())
  driverId  String
  lat       Float
  lng       Float
  speed     Float?
  bearing   Float?
  accuracy  Float?
  timestamp DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, timestamp])
  @@map("driver_location_logs")
}

model DriverEarning {
  id          String   @id @default(cuid())
  driverId    String
  orderId     String?
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("SDG")
  type        String
  description String?
  createdAt   DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@map("driver_earnings")
}

model ProofOfDelivery {
  id            String   @id @default(cuid())
  orderId       String   @unique
  driverId      String
  photoUrl      String?
  recipientName String?
  notes         String?
  deliveredAt   DateTime @default(now())
  lat           Float?
  lng           Float?

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@map("proof_of_deliveries")
}

// ============================================================================
// CRM MODELS
// ============================================================================

model PromoCode {
  id             String    @id @default(cuid())
  merchantId     String
  code           String
  type           PromoType
  value          Decimal   @db.Decimal(10, 2)
  minOrderAmount Decimal?  @db.Decimal(10, 2)
  maxDiscount    Decimal?  @db.Decimal(10, 2)
  usageLimit     Int?
  usageCount     Int       @default(0)
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, code])
  @@index([merchantId])
  @@map("promo_codes")
}

model LoyaltyAccount {
  id         String   @id @default(cuid())
  customerId String   @unique
  merchantId String
  points     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@index([merchantId])
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id               String   @id @default(cuid())
  loyaltyAccountId String
  orderId          String?
  points           Int
  type             String
  description      String?
  createdAt        DateTime @default(now())

  account LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)

  @@index([loyaltyAccountId])
  @@map("loyalty_transactions")
}

model LoyaltyConfig {
  id                  String   @id @default(cuid())
  merchantId          String   @unique
  isEnabled           Boolean  @default(false)
  pointsPerOrder      Int      @default(10)
  pointsPerSDG        Decimal  @default(1) @db.Decimal(10, 2)
  redemptionThreshold Int      @default(100)
  redemptionValueSDG  Decimal  @default(5) @db.Decimal(10, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("loyalty_configs")
}

// ============================================================================
// INBOX — Customer conversations
// ============================================================================

enum InboxChannel {
  WEB
  WHATSAPP
  MESSENGER
  INSTAGRAM
}

enum ConvStatus {
  OPEN
  PENDING
  CLOSED
}

model Conversation {
  id              String         @id @default(cuid())
  merchantId      String
  channel         InboxChannel   @default(WEB)
  customerName    String?
  customerPhone   String?
  status          ConvStatus     @default(OPEN)
  assignedToId    String?
  /// Numbered-menu WhatsApp ordering-bot state for this thread (see
  /// whatsapp-ordering module) — null means no bot flow is in progress,
  /// in which case the conversation behaves exactly like a normal support
  /// thread. Never touched by non-WhatsApp channels.
  orderContext    Json?
  /// True when a customer or staff member requested human ownership.
  aiAgentPaused   Boolean        @default(false)
  /// Hash of the opaque browser token used by storefront customers to
  /// continue a web conversation without creating a platform account.
  publicTokenHash String?        @unique
  messages        InboxMessage[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  merchant        Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([status])
  @@map("conversations")
}

model InboxMessage {
  id             String       @id @default(cuid())
  conversationId String
  content        String
  isFromCustomer Boolean      @default(true)
  senderName     String?
  /// Provider message ID; null for web/manual messages. Prevents webhook retries from duplicating replies.
  externalId     String?      @unique
  /// Set when the receiving side opens the thread.
  readAt         DateTime?
  sentAt         DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, readAt])
  @@map("inbox_messages")
}

model Complaint {
  id              String            @id @default(cuid())
  ticketNumber    String            @unique
  merchantId      String
  orderId         String?
  category        ComplaintCategory
  priority        ComplaintPriority @default(NORMAL)
  status          ComplaintStatus   @default(NEW)
  title           String
  description     String
  customerName    String
  customerPhone   String?
  customerEmail   String?
  publicTokenHash String            @unique
  resolution      String?
  assignedToId    String?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  merchant    Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order       Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages    ComplaintMessage[]
  attachments ComplaintAttachment[]

  @@index([merchantId, status, createdAt])
  @@index([orderId])
  @@index([status, priority, createdAt])
  @@map("complaints")
}

model ComplaintMessage {
  id             String   @id @default(cuid())
  complaintId    String
  content        String
  senderType     String
  senderName     String?
  isInternalNote Boolean  @default(false)
  createdAt      DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
  @@map("complaint_messages")
}

model ComplaintAttachment {
  id          String   @id @default(cuid())
  complaintId String
  storageKey  String   @unique
  fileName    String
  mimeType    String
  size        Int
  uploadedBy  String
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
  @@map("complaint_attachments")
}

/// Per-merchant WhatsApp Business API credentials (each merchant messages
/// customers from their own WhatsApp number). accessToken is stored encrypted
/// at rest — see src/lib/crypto/secret.ts. phoneNumberId is how inbound Meta
/// webhooks are routed back to the owning merchant.
model WhatsAppConfig {
  id             String  @id @default(cuid())
  merchantId     String  @unique
  phoneNumberId  String  @unique
  wabaId         String?
  displayPhone   String?
  accessToken    String // encrypted
  isActive       Boolean @default(true)
  aiAgentEnabled Boolean @default(false)
  aiAgentPrompt  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([phoneNumberId])
  @@map("whatsapp_configs")
}

/// Monthly usage claim for the opt-in WhatsApp AI customer-service agent.
model WhatsAppAiUsage {
  id         String @id @default(cuid())
  merchantId String
  periodKey  String
  count      Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  merchant  Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, periodKey])
  @@index([periodKey])
  @@map("whatsapp_ai_usage")
}

/// Atomic entitlement usage bucket owned by Wasla. AI providers execute the
/// operation, but Wasla remains the source of truth for merchant quotas.
model AiUsageBucket {
  id            String @id @default(cuid())
  merchantId    String
  featureKey    String
  periodKey     String
  limitSnapshot Int
  usedUnits     Int    @default(0)
  reservedUnits Int    @default(0)

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  merchant   Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  operations AiUsageOperation[]

  @@unique([merchantId, featureKey, periodKey])
  @@index([merchantId, periodKey])
  @@map("ai_usage_buckets")
}

/// Idempotent lifecycle record for one billable AI operation. Provider cost is
/// tracked separately from merchant quota so failed provider calls can release
/// merchant units while preserving the platform's real cost record.
model AiUsageOperation {
  id                String                 @id @default(cuid())
  merchantId        String
  bucketId          String
  featureKey        String
  idempotencyKey    String
  status            AiUsageOperationStatus @default(RESERVED)
  units             Int                    @default(1)
  provider          String?
  providerRequestId String?
  model             String?
  inputTokens       Int?
  outputTokens      Int?
  estimatedCostUsd  Decimal?               @db.Decimal(12, 6)
  failureCode       String?
  failureMessage    String?
  metadata          Json?
  expiresAt         DateTime
  committedAt       DateTime?
  releasedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  merchant Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  bucket   AiUsageBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  @@unique([merchantId, featureKey, idempotencyKey])
  @@index([status, expiresAt])
  @@index([merchantId, createdAt])
  @@map("ai_usage_operations")
}
