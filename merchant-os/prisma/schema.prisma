// ============================================================================
// WASLA Commerce OS — Prisma Schema
// Multi-tenant SaaS platform for merchants
// (restaurants, cafes, groceries, pharmacies, retail stores)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum BusinessType {
  RESTAURANT
  CAFE
  GROCERY
  PHARMACY
  RETAIL
  OTHER
}

enum StoreType {
  FOOD_MENU
  ONLINE_STORE
  SERVICES
  BOOKING
  OTHER
}

enum MerchantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum DistributorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum DeliveryPartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum DeliveryPartnerAppStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
  REJECTED
}

enum ComplaintStatus {
  NEW
  UNDER_REVIEW
  WAITING_MERCHANT
  WAITING_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

enum ComplaintPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ComplaintCategory {
  ORDER
  DELIVERY
  PAYMENT
  PRODUCT
  SERVICE
  OTHER
}

enum DeliveryQuoteStatus {
  OFFERED
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum PlatformShipmentStatus {
  REQUESTED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum CodCollectionStatus {
  PENDING
  COLLECTED
  REMITTED
  DISPUTED
  WRITTEN_OFF
}

enum UserRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  PLATFORM_OPERATIONS
  PLATFORM_FINANCE
  PLATFORM_SUPPORT
  DISTRIBUTOR_OWNER
  DISTRIBUTOR_ADMIN
  DELIVERY_PARTNER_OWNER
  DELIVERY_PARTNER_ADMIN
  MERCHANT_OWNER
  MERCHANT_ADMIN
  BRANCH_MANAGER
  CASHIER
  INVENTORY_MANAGER
  DELIVERY_STAFF
  CUSTOMER_SERVICE
  FINANCE_AGENT
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
}

enum DeliveryMethod {
  PICKUP
  MERCHANT_DELIVERY
  WASLAK_DELIVERY
  EXTERNAL_DELIVERY
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  WALLET
  MANUAL_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum MerchantReferralStatus {
