  ACTIVATED
  QUALIFIED
  REJECTED
}

enum ReferralQualificationRule {
  FIRST_DELIVERED_ORDER
  FIRST_PAID_PRO
}

enum ReferralRewardType {
  PRO_DAYS
  AI_CREDITS
  ACCOUNT_CREDIT
  CASH
}

enum ReferralRewardStatus {
